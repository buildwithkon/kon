{
  "name": "@konxyz/monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "KON v2 — no-code on-chain app framework. Vite + Preact runtime, ENS + IPFS + GUN.js + Safe smart accounts.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "@dashboard": "bun --filter=@konxyz/dashboard",
    "@dashboard:dev": "bun --filter=@konxyz/dashboard run dev",
    "@runtime": "bun --filter=@konxyz/runtime",
    "@runtime:dev": "bun --filter=@konxyz/runtime run dev",
    "@wallet": "bun --filter=@konxyz/wallet",
    "@wallet:dev": "bun --filter=@konxyz/wallet run dev",
    "@site": "bun --filter=@konxyz/site",
    "@site:dev": "bun --filter=@konxyz/site run dev",
    "@relay": "bun --filter=@konxyz/kon-relay",
    "@relay:start": "bun --filter=@konxyz/kon-relay run start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:origins": "bun scripts/lint-no-hardcoded-origins.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "publish:app": "bun scripts/publish.mjs",
    "publish:site": "bun scripts/publish-site.mjs",
    "publish:runtime": "bun scripts/publish-runtime.mjs",
    "publish:plugin": "bun scripts/publish-plugin.mjs",
    "typecheck:v2": "bun --filter=@konxyz/runtime-core run typecheck && bun --filter=@konxyz/schemas run typecheck"
  },
  "devDependencies": {
    "@web3-storage/upload-client": "^17.1.4",
    "@web3-storage/w3up-client": "^17.3.0",
    "blockstore-fs": "^4.0.1",
    "concurrently": "^9.1.2",
    "ipfs-unixfs-importer": "^17.0.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "viem": "^2.51.3",
    "wait-on": "^8.0.3",
    "wrangler": "^4.20.5"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
