{
  "name": "@konxyz/v1",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "main": "index.js",
  "scripts": {
    "@agent": "bun --filter=@konxyz/xmtp-agent",
    "@api": "bun --filter=@konxyz/api",
    "@api:dev": "bun --filter=@konxyz/api run dev",
    "@dashboard": "bun --filter=@konxyz/dashboard",
    "@dashboard:dev": "bun --filter=@konxyz/dashboard run dev",
    "@pwa": "bun --filter=@konxyz/app-pwa",
    "@pwa:dev": "bun --filter=@konxyz/app-pwa run dev",
    "@site": "bun --filter=@konxyz/site",
    "@site:dev": "bun --filter=@konxyz/site run dev",
    "@sh": "bun --filter=@konxyz/shared",
    "@shr": "bun --filter=@konxyz/shared-react",
    "@router": "bun --filter=@konxyz/subdomain-router",
    "dev": "concurrently \"bun run @api:dev\" \"bun run @pwa:dev\"",
    "start": "concurrently \"bun --filter=@konxyz/api run dev --port=8786\" \"wait-on tcp:8786 && bun --filter=@konxyz/app-pwa run start\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:origins": "bun scripts/lint-no-hardcoded-origins.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "publish:app": "bun scripts/publish.mjs",
    "publish:site": "bun scripts/publish-site.mjs",
    "publish:runtime": "bun scripts/publish-runtime.mjs",
    "publish:plugin": "bun scripts/publish-plugin.mjs",
    "typecheck:v2": "bun --filter=@konxyz/runtime-core run typecheck && bun --filter=@konxyz/schemas run typecheck"
  },
  "devDependencies": {
    "@web3-storage/upload-client": "^17.1.4",
    "@web3-storage/w3up-client": "^17.3.0",
    "blockstore-fs": "^4.0.1",
    "concurrently": "^9.1.2",
    "ipfs-unixfs-importer": "^17.0.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "viem": "^2.51.3",
    "wait-on": "^8.0.3",
    "wrangler": "^4.20.5"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
