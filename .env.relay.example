# KON relay stack env (consumed by docker-compose.yml + Caddyfile).
#
# Copy to .env at repo root before running `docker compose up -d`.
# .env is in .gitignore — never commit your real values.

# Root domain. Caddy will issue certs for relay.<KON_RELAY_DOMAIN> and
# gateway.<KON_RELAY_DOMAIN>. DNS A records must already point at this
# host before bringing the stack up (Let's Encrypt HTTP-01 challenges
# require live DNS).
#
# KON team default: kon.xyz
# Self-host example: myfestival.com
KON_RELAY_DOMAIN=

# Email Caddy registers with Let's Encrypt. ACME notifies you here if a
# cert is about to expire because of an outage. Use a monitored address.
ACME_EMAIL=

# Optional: comma-separated multiaddrs to advertise externally for
# libp2p. Required when the VPS is behind NAT (most aren't), or when
# you want the DHT to announce a stable DNS-based address instead of
# raw IPv4.
#
# Examples:
#   /dns4/kon.xyz/tcp/4001
#   /dns4/myfestival.com/tcp/4001,/ip4/198.51.100.42/tcp/4001
KON_RELAY_ANNOUNCE=

# Optional — multi-region scaling.
#
# When running this stack in multiple regions (Stage 2+), set this on
# each region to the public /gun URLs of the OTHER regions. GUN's CRDT
# gossip will then keep chat + draft graphs in sync across regions
# without any application-level coordination.
#
# Leave empty for single-region deployments (Stage 1 / typical
# self-host).
#
# Example for the Tokyo region:
#   KON_GUN_PEERS=https://fra.relay.kon.xyz/gun,https://iad.relay.kon.xyz/gun
#
# Example for self-host with one extra failover region:
#   KON_GUN_PEERS=https://backup.relay.myfestival.com/gun
KON_GUN_PEERS=

# Optional — /api/pin abuse controls on relay-ipfs.
# Defaults are tuned for an ETHTokyo-scale single-relay deployment.
# Tighten for public KON-managed deploy, loosen for your own self-host.
#
#   KON_PIN_RPM             requests per minute per IP    (default 10)
#   KON_PIN_BYTES_PER_DAY   bytes per day per IP           (default 100 MB)
#   KON_PIN_MAX_BODY        single-request body cap        (default 10 MB)
KON_PIN_RPM=
KON_PIN_BYTES_PER_DAY=
KON_PIN_MAX_BODY=
