# Root env template for the publish pipeline (scripts/publish.mjs).
# Copy to .env.local for local use, or set as GitHub Actions secrets
# for CI. Files .env / .env.local are gitignored; only this example is
# committed.

# web3.storage delegation — required for `pnpm publish:app --upload`.
# Generate with: w3 key create  →  W3_PRINCIPAL
# Then: w3 delegation create <did:from W3_PRINCIPAL> --can space/blob/add ...
#       --can upload/add --can filecoin/offer --base64  →  W3_PROOF
W3_PRINCIPAL=
W3_PROOF=

# ENS contenthash deploy key — required for `pnpm publish:app --publish`.
# Hex private key authorized to update the `<app>.kon.xyz` subname.
# Treat as a hot wallet for ENS only; do not reuse for funds.
# Gated: not yet wired pending the ENS DNS-import setup for kon.xyz.
KON_DEPLOY_KEY=

# Optional override for the Ethereum RPC used when updating ENS.
# Defaults to https://eth.llamarpc.com.
ENS_RPC_URL=
