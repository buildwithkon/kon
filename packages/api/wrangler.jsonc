// apps/pwa/wrangler.jsonc
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kon-api",
  "compatibility_date": "2025-02-24",
  "main": "src/index.ts",
  "vars": {
    "ENV": "development"
  },
  "env": {
    "production": {
      "vars": {
        "ENV": "production"
      },
      // Configure a D1 binding for the API (example)
      // "d1_databases": [
      //   {
      //     "binding": "APP_DB",
      //     "database_name": "kon-app-db",
      //     "database_id": "<your-d1-database-id>"
      //   }
      // ],
      "routes": [
        {
          "pattern": "api.kon.xyz",
          "custom_domain": true
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "ALCHEMY_API_KEY",
          "store_id": "97afb9f31a864e728b81e32277f335e0",
          "secret_name": "KON_ALCHEMY_API_KEY"
        }
      ]
    },
    "staging": {
      "vars": {
        "ENV": "staging"
      },
      // Configure a D1 binding for the API (example)
      // "d1_databases": [
      //   {
      //     "binding": "APP_DB",
      //     "database_name": "kon-app-db",
      //     "database_id": "<your-d1-database-id>"
      //   }
      // ],
      "routes": [
        {
          "pattern": "api.kon.wtf",
          "custom_domain": true
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "ALCHEMY_API_KEY",
          "store_id": "97afb9f31a864e728b81e32277f335e0",
          "secret_name": "KON_ALCHEMY_API_KEY"
        }
      ]
    }
  },
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  }
}
