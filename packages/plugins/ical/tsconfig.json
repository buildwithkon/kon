{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "types": [],
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "preact",
    "isolatedModules": true
  },
  "include": ["src"]
}
