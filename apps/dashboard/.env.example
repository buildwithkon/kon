# apps/dashboard environment template. Copy to .env.local for local
# smoke testing; .env.local is gitignored.
#
# Production builds leave both unset — the dashboard derives wallet
# + pin endpoints from window.location.hostname (my.<root> →
# id.<root> / gateway.<root>/api/pin) and there's nothing to inject.
#
# For local smoke testing (see docs/smoke-test.md), set these so the
# dashboard at http://localhost:5177 points at a locally-running
# wallet + relay-ipfs instead of the production KON-managed origins
# (which may not exist yet during initial deploy).

# Vite-only dev overrides. Read at build time via import.meta.env.
VITE_DEV_WALLET_ORIGIN=
VITE_DEV_PIN_ENDPOINT=
