# apps/account environment template. Copy to .env.local for local dev.
# .env.local is gitignored; only .env.example is committed.
#
# Pimlico (ERC-4337 bundler + paymaster) — required for real UserOp
# submission once step 8d/8e of the wallet impl ships. Get a key at
# https://dashboard.pimlico.io
PIMLICO_API_KEY=

# Sponsorship policy id from the Pimlico dashboard. Empty = no
# paymaster (user pays gas). Step 8e wires this through.
SPONSORSHIP_POLICY_ID=
