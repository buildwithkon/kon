    "@konxyz/plugin-forum": "workspace:*",
    "@konxyz/plugin-ical": "workspace:*",
    "@konxyz/plugin-iframe": "workspace:*",
    "@konxyz/plugin-markdown": "workspace:*",
    "@konxyz/plugin-profile-card": "workspace:*",
    "@konxyz/runtime-core": "workspace:*",
    "@konxyz/schemas": "workspace:*",
    "@preact/signals": "^1.3.0",
    "preact": "^10.24.0",
    "react-icons": "5.6.0",
    "viem": "^2.30.5"
  },
  "devDependencies": {
